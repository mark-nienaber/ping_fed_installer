# Product archives and licences are user-supplied and never committed. The
# software/pd, software/pf and software/pa folders stay in the repo (empty) so
# it is clear where the zips and .lic files go.
software/*/*
!software/*/.gitkeep
*.zip
*.lic

# Installation state + logs
.install-state
/tmp/.ping_install_state
*.log
logs/

# Claude local config
.claude/

# Python bytecode
__pycache__/
*.pyc

# Editor / OS cruft
.DS_Store
*.swp
