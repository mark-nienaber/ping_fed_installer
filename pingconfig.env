# ==========================================================
# Ping Installer — Environment Configuration
#   PingDirectory + PingFederate + PingAccess (single-node,
#   fully integrated, Admin-API driven)
# ==========================================================
#
# Everything the installer needs is defined here. Product install
# scripts and the orchestrator all `source ./pingconfig.env`.
#
# Change these values to match your environment, then run:
#   1. ./bin/ping-setup.sh        # prerequisites (JDK, user, dirs, hosts)
#   2. ./bin/install_ping.sh --all
# ==========================================================

# ----------------------------------------------------------
# Host / identity basics
# ----------------------------------------------------------
# System user that owns and runs all Ping services (create before install)
INSTALL_USER="fradmin"

# Base directory where all three products are installed
# (each product gets its own subdirectory under here)
BASE_INSTALL_DIR="/ping"

# Hostname all three products bind/advertise on (single-node = same host).
# Added to /etc/hosts by ping-setup.sh if not resolvable.
PING_HOSTNAME="ping.example.com"
PINGDIR_HOSTNAME="${PING_HOSTNAME}"
PINGFED_HOSTNAME="${PING_HOSTNAME}"
PINGACCESS_HOSTNAME="${PING_HOSTNAME}"

# ----------------------------------------------------------
# Instance counts — set to 2 to build a replicated / clustered tier.
# PingAccess is deployed single-instance and has no count.
# ----------------------------------------------------------
PINGDIR_COUNT=2
PINGFED_COUNT=2

# ----------------------------------------------------------
# Feature flags — control optional Phase 3 content
# ----------------------------------------------------------
INSTALL_SAMPLE_APP=true       # false = skip the PA-protected sample app
INSTALL_TEST_USERS=true       # false = skip seeding test users into PingDirectory
INSTALL_OIDC_CLIENT=true      # false = skip the sample OAuth/OIDC client in PingFederate

# Number of test users to create (testuser1..N) in PingDirectory
TEST_USER_COUNT=5

# ==========================================================
# SECURITY — CHANGE THESE BEFORE PRODUCTION!
# ==========================================================
# Shared default admin password. Meets PD/PF/PA complexity rules
# (upper + lower + digit + special, length >= 8).
DEFAULT_PASSWORD="2FederateM0re!"

# PingDirectory root user (cn=Directory Manager)
PINGDIR_ROOT_DN="cn=Directory Manager"
PINGDIR_ROOT_PASSWORD="${DEFAULT_PASSWORD}"

# PingFederate admin console/API user
PINGFED_ADMIN_USER="administrator"
PINGFED_ADMIN_PASSWORD="${DEFAULT_PASSWORD}"

# PingAccess admin console/API user
PINGACCESS_ADMIN_USER="administrator"
PINGACCESS_ADMIN_PASSWORD="${DEFAULT_PASSWORD}"

# LDAP bind account PingFederate uses to read PingDirectory (service account)
LDAP_BIND_DN="cn=pingfederate,ou=applications,dc=example,dc=com"
LDAP_BIND_PASSWORD="${DEFAULT_PASSWORD}"

# ==========================================================
# WARNING: changing values below may affect installation behavior
# ==========================================================
SCRIPT_DIR="$(pwd)"

# ----------------------------------------------------------
# Software drop-zones + license files (auto-detected by glob)
# ----------------------------------------------------------
SOFTWARE_DIR="${SCRIPT_DIR}/software"
PINGDIR_SOFTWARE_DIR="${SOFTWARE_DIR}/pd"
PINGFED_SOFTWARE_DIR="${SOFTWARE_DIR}/pf"
PINGACCESS_SOFTWARE_DIR="${SOFTWARE_DIR}/pa"

# License files (glob so version bumps don't break paths)
PINGDIR_LICENSE="$(find "${PINGDIR_SOFTWARE_DIR}"     -maxdepth 1 -name '*.lic' -type f 2>/dev/null | head -n1)"
PINGFED_LICENSE="$(find "${PINGFED_SOFTWARE_DIR}"     -maxdepth 1 -name '*.lic' -type f 2>/dev/null | head -n1)"
PINGACCESS_LICENSE="$(find "${PINGACCESS_SOFTWARE_DIR}" -maxdepth 1 -name '*.lic' -type f 2>/dev/null | head -n1)"

# ----------------------------------------------------------
# Install directories (where each product lands after extract)
# ----------------------------------------------------------
PINGDIR_DIR="${BASE_INSTALL_DIR}/pingdirectory"
PINGFED_DIR="${BASE_INSTALL_DIR}/pingfederate"
PINGACCESS_DIR="${BASE_INSTALL_DIR}/pingaccess"

# ----------------------------------------------------------
# Per-product install scripts (relative to project root)
# ----------------------------------------------------------
PINGDIR_SCRIPT="./pingdir/pingdir.sh"
PINGFED_SCRIPT="./pingfed/pingfed.sh"
PINGACCESS_SCRIPT="./pingaccess/pingaccess.sh"

# ==========================================================
# PingDirectory — LDAP data store (installed FIRST)
# ==========================================================
PINGDIR_BASE_DN="dc=example,dc=com"
PINGDIR_LDAP_PORT=1389
PINGDIR_LDAPS_PORT=1636
PINGDIR_HTTPS_PORT=1443          # Administrative API + SCIM
# NOTE: PingDirectory's administration connector rides on the LDAPS port
# (there is no --adminConnectorPort setup flag). This port is the REPLICATION
# port, used only when PINGDIR_COUNT > 1 (dsreplication / manage-topology).
PINGDIR_REPLICATION_PORT=8989
PINGDIR_JMX_PORT=1689
PINGDIR_INSTANCE_NAME="pingdirectory-1"
# Sample data: number of entries manage-profile/import seeds (0 = base DN only)
PINGDIR_SAMPLE_ENTRIES=0

# ==========================================================
# PingFederate — federation / OAuth / OIDC (installed SECOND)
#   Uses PingDirectory as its LDAP datastore.
# ==========================================================
PINGFED_ADMIN_PORT=9999          # admin console + /pf-admin-api/v1 (HTTPS)
PINGFED_ENGINE_PORT=9031         # runtime engine (HTTPS)
PINGFED_ADMIN_API="https://${PINGFED_HOSTNAME}:${PINGFED_ADMIN_PORT}/pf-admin-api/v1"
PINGFED_BASE_URL="https://${PINGFED_HOSTNAME}:${PINGFED_ENGINE_PORT}"
# Sample OAuth/OIDC client wired for the PingAccess sample app
PINGFED_OIDC_CLIENT_ID="pingaccess-client"
PINGFED_OIDC_CLIENT_SECRET="${DEFAULT_PASSWORD}"

# ----------------------------------------------------------
# Externalized session + OAuth grant storage (CUSTOMER PATTERN)
# ----------------------------------------------------------
# Real-customer topology: PingFederate does NOT keep authentication
# sessions or OAuth persistent grants in memory. It persists them to
# PingDirectory over LDAP, so sessions survive restarts and are shared
# across engine nodes when clustered.
#   "pingdirectory" = externalize to PD (default here)
#   "memory"        = in-memory (dev only; lost on restart)
PINGFED_SESSION_STORAGE="pingdirectory"

# LDAP locations in PingDirectory where PF writes this state.
# configure_pingdir creates these containers; configure_pingfed points at them.
# These OU names match PingFederate's own shipped PingDirectory LDIFs
# (conf/access-grant + conf/authentication-session), so PF's schema and our
# container names line up exactly.
PINGFED_SESSIONS_BASE_DN="ou=AuthenticationSessions,${PINGDIR_BASE_DN}"
PINGFED_GRANTS_BASE_DN="ou=AccessGrant,${PINGDIR_BASE_DN}"
# PingDirectory datastore PingFederate references for the above
# (the same LDAP_BIND_DN service account defined in the security section)
PINGFED_PD_DATASTORE_ID="pingdirectory-ldap"

# ----------------------------------------------------------
# PingFederate admin authentication via PingDirectory (LDAP)
# ----------------------------------------------------------
# Stock PF has no headless native-admin seed, so we authenticate PF admins
# against PingDirectory: configure_pingdir creates the user + group below,
# configure_pingfed points bin/ldap.properties + run.properties at PD.
# The PF admin then logs in / calls /pf-admin-api as this LDAP user.
PINGFED_ADMIN_UID="pfadmin"
PINGFED_ADMIN_USER_DN="uid=${PINGFED_ADMIN_UID},ou=people,${PINGDIR_BASE_DN}"
PINGFED_ADMIN_GROUP_DN="cn=pf-admins,ou=groups,${PINGDIR_BASE_DN}"
# For dev we bind admin auth over plaintext LDAP to avoid self-signed LDAPS
# trust setup. Switch to ldaps://:${PINGDIR_LDAPS_PORT} + cert import for prod.
PINGFED_ADMIN_LDAP_URL="ldap://${PINGDIR_HOSTNAME}:${PINGDIR_LDAP_PORT}"

# ----------------------------------------------------------
# PingDirectory directory content (created by configure_pingdir)
# ----------------------------------------------------------
PINGDIR_PEOPLE_DN="ou=people,${PINGDIR_BASE_DN}"
PINGDIR_GROUPS_DN="ou=groups,${PINGDIR_BASE_DN}"
PINGDIR_APPS_DN="ou=applications,${PINGDIR_BASE_DN}"

# ==========================================================
# PingAccess — access gateway / reverse proxy (installed THIRD)
#   Uses PingFederate as its token provider.
# ==========================================================
PINGACCESS_ADMIN_PORT=9000       # admin console + /pa-admin-api/v3 (HTTPS)
PINGACCESS_ENGINE_PORT=3000      # runtime engine (HTTPS)
PINGACCESS_AGENT_PORT=3030       # agent protocol
PINGACCESS_ADMIN_API="https://${PINGACCESS_HOSTNAME}:${PINGACCESS_ADMIN_PORT}/pa-admin-api/v3"
# Sample protected application served through PingAccess
SAMPLE_APP_VIRTUAL_HOST="app.example.com"
SAMPLE_APP_TARGET="http://localhost:8090"   # origin PA reverse-proxies to (bundled sample-app.py)

# ==========================================================
# MULTI-NODE / CLUSTER / LOAD BALANCER
#   Activated when the *_COUNT values above are > 1. Single-host
#   demo topology: every instance is co-located, so the second
#   node of each product gets its own install dir + port offsets.
#   Real deployments spread these across hosts (same ports, one
#   per box); the port offsets here only exist to co-locate.
# ==========================================================

# ---- PingDirectory node 2 (replication peer of node 1) ----
PINGDIR2_DIR="${BASE_INSTALL_DIR}/pingdirectory-2"
PINGDIR2_INSTANCE_NAME="pingdirectory-2"
PINGDIR2_LDAP_PORT=2389
PINGDIR2_LDAPS_PORT=2636
PINGDIR2_HTTPS_PORT=2443
PINGDIR2_REPLICATION_PORT=8990
# Global/topology admin account dsreplication creates to manage the topology
# (distinct from cn=Directory Manager). Used for enable + initialize + status.
PINGDIR_REPL_ADMIN_UID="admin"
PINGDIR_REPL_ADMIN_PASSWORD="${DEFAULT_PASSWORD}"
# Smaller heap for the co-located second instance (host RAM is shared).
PINGDIR2_MAX_HEAP="768m"

# ---- PingFederate node 2 (CLUSTERED_ENGINE; node 1 = CLUSTERED_CONSOLE) ----
PINGFED2_DIR="${BASE_INSTALL_DIR}/pingfederate-2"
# Engine runtime port on node 2 (node 1 keeps 9031; distinct to co-locate).
PINGFED2_ENGINE_PORT=9032
# JGroups cluster transport (TCP). Node 1 uses the stock 7600/7700; node 2 is
# offset so both can bind on the same host. All nodes list each other under
# tcp.discovery.initial.hosts.
PINGFED_CLUSTER_BIND_PORT_1=7600
PINGFED_CLUSTER_FAILOVER_PORT_1=7700
PINGFED_CLUSTER_BIND_PORT_2=7602
PINGFED_CLUSTER_FAILOVER_PORT_2=7702
# Shared cluster auth key (generated by bin/clusterkey.sh at configure time if
# left blank; both nodes must carry the identical value).
PINGFED_CLUSTER_AUTH_PWD=""
PINGFED2_MAX_HEAP="768m"

# ---- Load balancer (front door, terminates TLS) ----
# HAProxy terminates client TLS on :443 and routes by SNI/Host to the runtime
# tiers: ping.<domain> -> PingFederate engine node(s); app.<domain> -> PingAccess
# engine. Re-encrypts to the HTTPS backends (TLS bridging). Installed by
# ping-setup.sh (dnf) when clustering is enabled.
LB_ENABLED=true
LB_HTTPS_PORT=443
LB_HOSTNAME_PF="${PINGFED_HOSTNAME}"     # ping.example.com  (OIDC front door)
LB_HOSTNAME_APP="${SAMPLE_APP_VIRTUAL_HOST:-app.example.com}"  # app front door
# Self-signed cert the LB presents (SAN covers both front-door hostnames).
LB_CERT_DIR="${BASE_INSTALL_DIR}/loadbalancer/certs"
LB_CFG="/etc/haproxy/haproxy.cfg"
# Public base URLs once the LB fronts the stack (no port = 443). PF issuer,
# OIDC redirect URIs and PA token-provider/vhost are rewired to these.
LB_PF_BASE_URL="https://${LB_HOSTNAME_PF}"
LB_APP_BASE_URL="https://${LB_HOSTNAME_APP}"

# ---- Live monitoring dashboard (bin/ping-dashboard.py) ----
# Self-contained HTTPS web dashboard; start with `bin/ping-control.sh start dash`.
# Serves TLS with a self-signed cert (SAN covers ${PING_HOSTNAME}); auto-generated
# on first start if DASHBOARD_CERT is absent.
DASHBOARD_PORT=8600
DASHBOARD_CERT="${BASE_INSTALL_DIR}/dashboard/dashboard.pem"

# ----------------------------------------------------------
# JAVA_HOME self-heal
# The inherited shell environment may carry a stale JAVA_HOME (e.g. a JDK that
# was later removed). All three products trust JAVA_HOME, so resolve it from the
# active `java` on PATH whenever it's unset or points at a missing JDK.
# ----------------------------------------------------------
if [[ -z "${JAVA_HOME:-}" || ! -x "${JAVA_HOME}/bin/java" ]]; then
    if command -v java >/dev/null 2>&1; then
        export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
    fi
fi

# ----------------------------------------------------------
# Runtime / logging
# ----------------------------------------------------------
LOG_DIR="/var/log/ping-installer"
# Minimum Java version required by PD 11 / PF 13.1 / PA 9.1
JAVA_MIN_VERSION=17
# JDK major version ping-setup.sh installs (21 LTS is supported by all three)
JDK_VERSION=21
# Minimum free disk (GB) under BASE_INSTALL_DIR.
# Extracted footprint of all three products is ~1.4GB (PD ~330M, PF ~690M,
# PA ~330M); 10GB leaves comfortable headroom for runtime data, logs, and the
# PingDirectory-backed session/OAuth-grant stores that grow under load.
REQUIRED_DISK_GB=10
